{
  "name": "agentpass-cli",
  "version": "0.1.0",
  "author": "IOG",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json && cp -R ../contract/src/managed dist/contract/src/managed",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "lint": "eslint src",
    "prepack": "npm run build",
    "standalone": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/standalone.ts",
    "preview-remote": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preview.ts",
    "preprod-remote": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preprod.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/scripted-demo.ts",
    "demo:server": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/demo-server.ts",
    "app": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/grant-server.ts",
    "app:e2e": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/grant-check.ts",
    "faucet": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/grant-faucet.ts",
    "devnet:up": "docker compose -f ../devnet/devnet.yml up -d",
    "devnet:down": "docker compose -f ../devnet/devnet.yml down",
    "deploy:preprod": "node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/preprod-deploy.ts",
    "app:preprod": "GRANT_NET=preprod node --experimental-specifier-resolution=node --loader ts-node/esm src/launcher/grant-server.ts"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.6.1"
  }
}
